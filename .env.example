# ==============================================================================
# AUTERGO AI INTERVIEW SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and populate your actual API keys and credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & ENVIRONMENT
# ------------------------------------------------------------------------------
ENV=development
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE (Async SQLAlchemy + asyncpg)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://autergo:autergo@localhost:5432/autergo

# ------------------------------------------------------------------------------
# 3. REDIS BROKER & CELERY WORKER
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (Clerk + Guest JWT)
# ------------------------------------------------------------------------------
# Clerk B2B Recruiter Authentication
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_JWKS_URL=https://clerk.autergo.com/.well-known/jwks.json

# Candidate Guest Access Token Secret (minimum 32-character string for HMAC-SHA256)
GUEST_SECRET_KEY=autergo_super_secret_guest_key_min_32_bytes_length!

# ------------------------------------------------------------------------------
# 5. AI INFERENCE & SECURITY (Groq Cloud)
# ------------------------------------------------------------------------------
# Powers adaptive technical interviewing (Llama 3.3 70B) & safety filters (Llama Guard 3)
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# 6. REALTIME SPEECH-TO-TEXT (Deepgram Nova-2)
# ------------------------------------------------------------------------------
# Sub-300ms real-time audio transcription over WebSockets
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ------------------------------------------------------------------------------
# 7. REALTIME TEXT-TO-SPEECH (Cartesia Sonic)
# ------------------------------------------------------------------------------
# Sub-100ms ultra-low latency conversational voice generation
CARTESIA_API_KEY=your_cartesia_api_key_here

# ------------------------------------------------------------------------------
# 8. WEBRTC AUDIO ROOM INFRASTRUCTURE (LiveKit Cloud or Self-Hosted)
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ------------------------------------------------------------------------------
# 9. TRANSACTIONAL EMAIL DISPATCH (Standard SMTP & Resend Fallback)
# ------------------------------------------------------------------------------
# Standard SMTP configuration (Zero-cost with any mail provider or corporate server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_app_password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=interviews@autergo.com

# Optional Resend API fallback
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=interviews@autergo.com

# ------------------------------------------------------------------------------
# 10. NVIDIA NIM LLM INFERENCE (Enterprise AI Models)
# ------------------------------------------------------------------------------
# NVIDIA NIM API (https://integrate.api.nvidia.com/v1)
NVIDIA_API_KEY=nvapi-your_nvidia_nim_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ------------------------------------------------------------------------------
# 11. HUGGING FACE FREE ZERO-COST VOICE MODELS
# ------------------------------------------------------------------------------
# Zero-cost open-weights audio STT (Whisper) & TTS pipeline
HF_API_TOKEN=hf_your_free_huggingface_token
HF_WHISPER_MODEL=openai/whisper-tiny
AUDIO_PROVIDER=auto
LLM_PROVIDER=auto

# ------------------------------------------------------------------------------
# 12. CLOUDFLARE R2 OBJECT STORAGE (S3-Compatible)
# ------------------------------------------------------------------------------
# Durably stores uploaded resumes and generated PDF evaluation reports
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=autergo-storage
R2_PUBLIC_URL=https://storage.autergo.com

